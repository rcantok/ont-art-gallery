    {
      "parameters": {
        "jsCode": "// Satırı Sheet'in başlık satırına göre dizer: sütun sırası değişse de her değer kendi sütununa yazılır.\n// Kayıt values.append (RAW) ile yapılır: n8n Sheets node'u boş satırı kendisi seçtiği için eşzamanlı siparişler\n// aynı satıra yazılıp birbirini silebiliyordu; RAW, \"=...\" ile başlayan girdinin formül olarak çalışmasını da engeller.\nconst headers = ($json.values && $json.values[0]) || [];\nif (!headers.length) throw new Error('Siparisler sekmesinde başlık satırı yok');\nconst body = $('ONT Webhook').first().json.body;\nconst cell = v => v == null ? '' : typeof v === 'object' ? JSON.stringify(v) : v;\nreturn [{ json: { values: [headers.map(h => cell(body[String(h).trim()]))] } }];"
      },
