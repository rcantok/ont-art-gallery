    {
      "parameters": {
        "jsCode": "// Gmail API'ye ham mail: n8n yalnızca gmail.send izinli bağlantıyla mail gönderebilir, posta kutusunu okuyamaz.\n// Başlıklara satır sonu girmez (tek alıcı, Bcc eklenemez); konu ve gönderen adı UTF-8 kodlanır. Buffer kullanmaz.\nconst SENDER = { name: \"ONT Art Gallery\", email: \"ragipcantok@gmail.com\" };\nconst B64 = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\nfunction utf8Bytes(s) {\n  const out = [];\n  for (const ch of String(s)) {\n    const c = ch.codePointAt(0);\n    if (c < 0x80) out.push(c);\n    else if (c < 0x800) out.push(0xc0 | (c >> 6), 0x80 | (c & 63));\n    else if (c < 0x10000) out.push(0xe0 | (c >> 12), 0x80 | ((c >> 6) & 63), 0x80 | (c & 63));\n    else out.push(0xf0 | (c >> 18), 0x80 | ((c >> 12) & 63), 0x80 | ((c >> 6) & 63), 0x80 | (c & 63));\n  }\n  return out;\n}\nfunction base64(bytes) {\n  let s = \"\";\n  for (let i = 0; i < bytes.length; i += 3) {\n    const n = (bytes[i] << 16) | ((bytes[i + 1] ?? 0) << 8) | (bytes[i + 2] ?? 0);\n    s += B64[(n >> 18) & 63] + B64[(n >> 12) & 63] + (i + 1 < bytes.length ? B64[(n >> 6) & 63] : \"=\") + (i + 2 < bytes.length ? B64[n & 63] : \"=\");\n  }\n  return s;\n}\nconst encodedWord = s => `=?UTF-8?B?${base64(utf8Bytes(s))}?=`;\nconst oneHeaderLine = s => String(s ?? \"\").replace(/[\\r\\n]+/g, \" \").trim();\nfunction gmailRaw(to, subject, body) {\n  const msg = [\n    `From: ${encodedWord(SENDER.name)} <${SENDER.email}>`,\n    `To: ${oneHeaderLine(to).split(/\\s+/)[0]}`,\n    `Subject: ${encodedWord(oneHeaderLine(subject))}`,\n    \"MIME-Version: 1.0\",\n    \"Content-Type: text/plain; charset=UTF-8\",\n    \"Content-Transfer-Encoding: 8bit\",\n    \"\",\n    String(body ?? \"\").replace(/\\r?\\n/g, \"\\r\\n\")\n  ].join(\"\\r\\n\");\n  return base64(utf8Bytes(msg)).replace(/\\+/g, \"-\").replace(/\\//g, \"_\").replace(/=+$/, \"\");\n}\nconst m = $input.first().json;\nreturn [{ json: { ...m, raw: gmailRaw(m.to, m.subject, m.body) } }];\n"
      },
