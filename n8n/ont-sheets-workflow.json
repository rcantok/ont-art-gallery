    {
      "parameters": {
        "jsCode": "// AI çıktısını {subject, body} JSON'una çevirir; model ```json ile sararsa da okur.\nconst raw = $input.first().json.text ?? '';\nconst m = raw.match(/\\{[\\s\\S]*\\}/);\nlet mail;\ntry { mail = JSON.parse(m[0]); } catch (e) { throw new Error('AI çıktısı JSON değil: ' + raw.slice(0, 300)); }\nconst info = $('Mail bilgisi hazırla').first().json;\nreturn [{ json: { to: info.to, subject: mail.subject, body: mail.body, model: 'deepseek-chat' } }];"
      },
