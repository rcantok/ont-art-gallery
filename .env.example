# Gerekli ortam değişkenleri (değerler burada değil: yerelde .env.local, canlıda Vercel → Environment Variables)
# Sipariş ve bildirim fişlerinin iletileceği adres
WEBHOOK_URL=
# Webhook'a X-ONT-Secret başlığıyla giden gizli anahtar; alıcı taraf bununla isteğin bizden geldiğini doğrular
WEBHOOK_SECRET=
